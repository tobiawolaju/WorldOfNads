[input_devices]

pointing/emulate_touch_from_mouse=true

[navigation]

world/map_use_async_iterations=false
world/region_use_async_iterations=false

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="GodotPhysics3D"
jolt_physics_3d/simulation/velocity_steps=5
jolt_physics_3d/limits/temporary_memory_buffer_size=16
3d/sleep_threshold_angular=0.2792526803190927
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=256
lights_and_shadows/directional_shadow/size.mobile=128
anti_aliasing/screen_space_roughness_limiter/enabled=false
scaling_3d/fsr_sharpness=1.0
textures/basis_universal/rdo_dict_size=256
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
lights_and_shadows/positional_shadow/atlas_size=256
lights_and_shadows/positional_shadow/atlas_size.mobile=128
lights_and_shadows/directional_shadow/size.web=128
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0

