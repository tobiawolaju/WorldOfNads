[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true
sensors/enable_magnetometer=true
sensors/enable_device_orientation=true
buffering/agile_event_flushing=true
pointing/emulate_touch_from_mouse=true

[physics]

3d/run_on_separate_thread=true
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=2
jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=false
jolt_physics_3d/motion_queries/recovery_iterations=2
common/physics_interpolation=true

[rendering]

rendering_device/vulkan/max_descriptors_per_pool=128
textures/streaming/enabled=true
textures/streaming/memory_budget_enabled=true
textures/streaming/memory_budget_mb=128
textures/streaming/max_ops_per_second=64
textures/streaming/inactivity_decay_rate_ms=500
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/lossless_compression/force_png=true
gl_compatibility/item_buffer_size=8192
global_illumination/gi/use_half_resolution=true
shading/overrides/force_vertex_shading=true
shading/overrides/force_lambert_over_burley=true
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=2.0
vrs/mode=1

[shader_globals]

player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
