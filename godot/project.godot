; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="wons"
run/main_scene="uid://duy1hgxhwdptc"
config/features=PackedStringArray("4.8", "GL Compatibility")
run/max_fps=60
run/low_processor_mode=true
boot_splash/bg_color=Color(0.43137255, 0.32941177, 1, 1)
boot_splash/image="uid://ct6moic2j0bbf"
config/icon="uid://ct6moic2j0bbf"

[autoload]

Game="*uid://cyhybl6vr827y"
GameManager="*uid://ypqfq50ulbig"
AuthManager="*res://auth/AuthManager.gd"
FxWarmup="*res://autoload/FxWarmup.gd"
DeviceOptimizer="*res://autoload/DeviceOptimizer.gd"

[display]

window/size/viewport_width=500
window/size/viewport_height=500
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=0

