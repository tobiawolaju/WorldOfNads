	// =================================
	//

	vec4 low = triplanar(
		low_albedo,
		world_pos,
		n
	);

	vec4 grass = triplanar(
		grass_albedo,
		world_pos,
		n
	);

	vec4 rock = triplanar(
		rock_albedo,
		world_pos,
		n
	);

	vec4 snow = triplanar(
		snow_albedo,
		world_pos,
		n
	);

	//
	// =================================
	// BASE TERRAIN
	// =================================
