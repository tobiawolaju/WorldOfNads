	else {

		terrain = low.rgb;
	}

	//
	// =================================
	// CLIFF OVERRIDE
	// =================================
	//

	terrain = mix(
		terrain,
		low.rgb,
		cliff_mask
	);

	//
	// =================================
	// FINAL
	// =================================
	//

	ALBEDO = terrain;

	ROUGHNESS = 0.96;

	SPECULAR = 0.03;
}"

