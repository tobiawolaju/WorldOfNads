//
// =====================================
// TRIPLANAR
// =====================================
//

vec4 triplanar(
	sampler2D tex,
	vec3 pos,
	vec3 normal
) {

	vec3 blend = abs(normal);

	blend = pow(
		blend,
		vec3(blend_sharpness)
	);

	blend /= (
		blend.x +
		blend.y +
		blend.z
