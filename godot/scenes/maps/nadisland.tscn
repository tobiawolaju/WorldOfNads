[sub_resource type="Shader" id="Shader_hva30"]
code = "shader_type spatial;

//
// ===== TEXTURES =====
//

uniform sampler2D snow_albedo : source_color;
uniform sampler2D rock_albedo : source_color;
uniform sampler2D grass_albedo : source_color;
uniform sampler2D low_albedo : source_color;

//
// ===== HEIGHT SETTINGS =====
//

uniform float snow_height = 45.0;
uniform float rock_height = 22.0;
uniform float grass_height = 6.0;

uniform float blend_strength = 4.0;

//
// ===== TRIPLANAR SETTINGS =====
//

uniform float texture_scale = 8.0;
uniform float sharpness = 4.0;

//
// ===== SLOPE SETTINGS =====
//

uniform float cliff_strength = 1.2;
uniform float cliff_start = 0.35;

varying vec3 world_pos;
varying vec3 world_normal;


//
// ===== VERTEX =====
//

void vertex() {

	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;

	world_normal = normalize(
		(MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz
	);
}


//
// ===== HEIGHT BLEND =====
//

float height_blend(float h, float target) {

	return smoothstep(
		target - blend_strength,
		target + blend_strength,
		h
	);
}


//
// ===== TRIPLANAR SAMPLING =====
//

vec4 triplanar_texture(
	sampler2D tex,
	vec3 pos,
	vec3 normal
) {

	vec3 blend = abs(normal);

	blend = pow(blend, vec3(sharpness));
	blend /= (blend.x + blend.y + blend.z);

	vec2 x_uv = pos.yz / texture_scale;
	vec2 y_uv = pos.xz / texture_scale;
	vec2 z_uv = pos.xy / texture_scale;

	vec4 x_tex = texture(tex, x_uv);
	vec4 y_tex = texture(tex, y_uv);
	vec4 z_tex = texture(tex, z_uv);

	return
		x_tex * blend.x +
		y_tex * blend.y +
		z_tex * blend.z;
}



//
// ===== FRAGMENT =====
//

void fragment() {

	float h = world_pos.y;

	vec3 n = normalize(world_normal);

	//
	// ===== SLOPE DETECTION =====
	//

	float slope = 1.0 - n.y;

	float cliff_mask = smoothstep(
		cliff_start,
		1.0,
		slope * cliff_strength
	);

	//
	// ===== SAMPLE TEXTURES =====
	//

	vec4 snow = triplanar_texture(
		snow_albedo,
		world_pos,
		n
	);

	vec4 rock = triplanar_texture(
		rock_albedo,
		world_pos,
		n
	);

	vec4 grass = triplanar_texture(
		grass_albedo,
		world_pos,
		n
	);

	vec4 low = triplanar_texture(
		low_albedo,
		world_pos,
		n
	);

	//
	// ===== HEIGHT MASKS =====
	//

	float snow_mask = height_blend(h, snow_height);

	float rock_mask = height_blend(h, rock_height);

	float grass_mask = height_blend(h, grass_height);

	//
	// ===== BASE TERRAIN BLENDING =====
	//

	vec4 terrain = low;

	terrain = mix(
		terrain,
		grass,
		grass_mask
	);

	terrain = mix(
		terrain,
		rock,
		rock_mask
	);

	terrain = mix(
		terrain,
		snow,
		snow_mask
	);

	//
	// ===== CLIFF OVERRIDE =====
	// Rocks appear on steep areas
	//

	terrain = mix(
		terrain,
		rock,
		cliff_mask
	);

	//
	// ===== FINAL =====
	//

	ALBEDO = terrain.rgb;

	ROUGHNESS = 0.95;
	SPECULAR = 0.05;
}"

