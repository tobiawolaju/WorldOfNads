ANALYTICS_DB_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
ADMIN_ACCESS_CODE=WONS
NODE_ENV=development
PORT=8080

# --- Device-linking authentication -------------------------------------------
# HMAC-SHA256 pepper for device-login code digests and request-IP hashes.
# Falls back to AUTH_TOKEN_SECRET, then to a throwaway per-process value.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every outstanding device login code. Native sessions
# use unpeppered token digests and therefore survive a rotation.
WON_AUTH_SECRET=CHANGE_ME_64_HEX_CHARS
# Origin serving the /auth approval page; the backend builds the QR URL from it.
WON_WEB_ORIGIN=https://worldofnads.xyz
# Device-login ticket lifetime, in seconds (clamped 30-900). Keep it short: the
# code is a bearer ticket for the account-linking step.
DEVICE_LOGIN_TTL_SECONDS=120
# Session lifetimes, in seconds.
NATIVE_ACCESS_TOKEN_TTL_SECONDS=3600
NATIVE_REFRESH_TOKEN_TTL_SECONDS=2592000
# In-memory per-IP rate limits for the device-login endpoints.
DEVICE_LOGIN_START_LIMIT=5
DEVICE_LOGIN_START_WINDOW_MS=60000
DEVICE_LOGIN_APPROVE_LIMIT=10
DEVICE_LOGIN_EXCHANGE_LIMIT=20

# Privy (server-side verification of the web approval).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Backend settlement (Monad Testnet — chainId 10143)
MN_RPC_URL=https://testnet-rpc.monad.xyz
TRUSTED_AUTHORITY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
MAIN_WALLET_ADDRESS=0xYOUR_MAIN_WALLET_ADDRESS
MATCH_ENGINE_ADDRESS=0x43aad0B78b614CbEB255730a6aDa278Ff4ABbED6
XP_TOKEN_ADDRESS=0xf616BCEd5bdbF61Eb8581150753BB3EEa887A718
LOOTBOX_ADDRESS=0x12A123E84B01663863327Bc2E354C7Ae0d8506c0
SKINS_ADDRESS=0x7f078947246fF77d86372448613F44816279e73b

# Solana settlement (devnet — deploy contracts-solana first)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SERVER_KEYPAIR_PATH=./solana-keypair.json
SOLANA_XP_TOKEN_ID=WONsXP111111111111111111111111111111111111
SOLANA_LOOTBOX_ID=WONsLootBox11111111111111111111111111111111
SOLANA_MATCH_ENGINE_ID=WONsMatchEngine111111111111111111111111111111
SOLANA_SKINS_ID=WONsSkins1111111111111111111111111111111111
